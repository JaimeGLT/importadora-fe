{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-importadora-production.up.railway.app/api/:path*"
    },
    {
      "source": "/graphql",
      "destination": "https://backend-importadora-production.up.railway.app/graphql"
    },
    {
      "source": "/hubs/:path*",
      "destination": "https://backend-importadora-production.up.railway.app/hubs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
